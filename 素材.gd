const 存档路径:String = "user://dice_game_save.cfg"

func 保存存档():
	var 存档 = ConfigFile.new()
	
	for 名字1 in 名字:
		存档.set_value(名字1, "分数", 素材.分数[名字1])
		存档.set_value(名字1, "段位", 素材.段位[名字1])
		存档.set_value(名字1, "胜利", 素材.胜利次数[名字1])
		存档.set_value(名字1, "失败", 素材.失败次数[名字1])
	存档.set_value("小组", "小组", 学习小组名单)
	
	var 错误 = 存档.save(存档路径)
	if 错误 == OK:
		print("存档成功！")
	else:
		print("存档失败，错误代码: ", 错误)

func 读取存档():
	var 存档 = ConfigFile.new()
	var 错误 = 存档.load(存档路径)
	
	if 错误 != OK:
		print("没有找到存档或存档损坏，将使用初始数据")
		return
	
	for 名字1 in 名字:
		if 存档.has_section_key(名字1, "分数"):
			分数[名字1] = 存档.get_value(名字1, "分数", 0)
		if 存档.has_section_key(名字1, "段位"):
			段位[名字1] = 存档.get_value(名字1, "段位", "青铜")
		if 存档.has_section_key(名字1, "胜利"):
			胜利次数[名字1] = 存档.get_value(名字1, "胜利", 0)
		if 存档.has_section_key(名字1, "失败"):
			失败次数[名字1] = 存档.get_value(名字1, "失败", 0)
	if 存档.has_section_key("小组", "小组"):
		学习小组名单 = 存档.get_value("小组", "小组", [])
	print("读档成功！")

func _ready() -> void:
	for i in 名字:
		抽取次数[i]=0
	读取存档()

